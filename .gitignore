node_modules/
# Build output of THIS package. Anchored on purpose: a bare `lib/` also matches
# any nested directory named `lib`, which silently excluded
# `dev/team-skill-admin/src/lib/` (13 tracked source files) from the repository.
/lib/
dist/
*.tsbuildinfo
.next/
.env
*.log
.pnpm-store/
*.tgz
# The demo service's compiled output; its sources live in `src/`.
dev/team-skill-service/lib/
# Gate evidence logs under docs/ are deliverables (red/green smoke runs, test
# retry transcripts); everything else stays ignored.
!docs/**/*.log

# Raw output of the last failing pnpm test run (see build/run-tests.mjs).
test-failures.log
