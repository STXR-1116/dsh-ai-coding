{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    // `tsc -p tsconfig.json` emits only declarations here; tsdown owns the
    // JavaScript halves (`lib/index.js` host, `lib/client.js` browser bundle).
    "outDir": "lib/types",
    // TypeScript 6 requires the output root explicitly once the program has a
    // common source directory; declarations mirror `src/**` under `lib/types`.
    "rootDir": "src"
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.d.ts"],
  "exclude": ["dev", "tests", "lib"]
}
